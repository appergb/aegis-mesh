{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aegis-mesh:schema:agent-response:1.0.0",
  "title": "Aegis Mesh agent response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "response_id", "incident_id", "agent_id", "agent_result_status", "confidence", "summary", "facts", "hypotheses", "unknowns", "evidence", "recommendations", "correlation_id", "completed_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "response_id": {"$ref": "urn:aegis-mesh:schema:incident-event:1.0.0#/$defs/uuid"},
    "incident_id": {"$ref": "urn:aegis-mesh:schema:incident-event:1.0.0#/$defs/uuid"},
    "agent_id": {"$ref": "urn:aegis-mesh:schema:incident-event:1.0.0#/$defs/id"},
    "agent_result_status": {"enum": ["complete", "partial", "blocked", "failed"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "summary": {"$ref": "urn:aegis-mesh:schema:incident-event:1.0.0#/$defs/nonEmptyText"},
    "facts": {"$ref": "urn:aegis-mesh:schema:incident-event:1.0.0#/$defs/textList"},
    "hypotheses": {"$ref": "urn:aegis-mesh:schema:incident-event:1.0.0#/$defs/textList"},
    "unknowns": {"$ref": "urn:aegis-mesh:schema:incident-event:1.0.0#/$defs/textList"},
    "evidence": {"type": "array", "items": {"$ref": "urn:aegis-mesh:schema:incident-event:1.0.0#/$defs/evidenceReference"}, "uniqueItems": true},
    "recommendations": {"$ref": "urn:aegis-mesh:schema:incident-event:1.0.0#/$defs/textList"},
    "correlation_id": {"$ref": "urn:aegis-mesh:schema:incident-event:1.0.0#/$defs/uuid"},
    "completed_at": {"$ref": "urn:aegis-mesh:schema:incident-event:1.0.0#/$defs/timestamp"}
  }
}
