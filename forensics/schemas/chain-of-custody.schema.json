{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aegis-mesh:schema:forensics:chain-of-custody:1.0.0",
  "title": "Aegis Mesh evidence manifest and chain of custody",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "incident_id", "created_at", "evidence_reference", "append_only", "storage_contract", "retention", "legal_hold", "events", "chain_head_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "format": "uuid"},
    "incident_id": {"type": "string", "format": "uuid"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "evidence_reference": {"$ref": "urn:aegis-mesh:schema:incident-event:1.0.0#/$defs/evidenceReference"},
    "append_only": {"const": true},
    "storage_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["configured", "provider", "immutable_store_ref", "production_gate"],
      "properties": {
        "configured": {"type": "boolean"},
        "provider": {"type": ["string", "null"], "maxLength": 128},
        "immutable_store_ref": {"type": ["string", "null"], "maxLength": 256},
        "production_gate": {"const": false}
      },
      "allOf": [
        {"if": {"properties": {"configured": {"const": false}}, "required": ["configured"]}, "then": {"properties": {"provider": {"type": "null"}, "immutable_store_ref": {"type": "null"}}}},
        {"if": {"properties": {"configured": {"const": true}}, "required": ["configured"]}, "then": {"properties": {"provider": {"type": "string", "minLength": 1}, "immutable_store_ref": {"type": "string", "minLength": 1}}}}
      ]
    },
    "retention": {
      "type": "object", "additionalProperties": false,
      "required": ["configured", "value", "unit"],
      "properties": {"configured": {"type": "boolean"}, "value": {"type": ["integer", "null"], "minimum": 1}, "unit": {"enum": ["days", "months", "years", null]}},
      "allOf": [
        {"if": {"properties": {"configured": {"const": false}}, "required": ["configured"]}, "then": {"properties": {"value": {"type": "null"}, "unit": {"type": "null"}}}},
        {"if": {"properties": {"configured": {"const": true}}, "required": ["configured"]}, "then": {"properties": {"value": {"type": "integer", "minimum": 1}, "unit": {"enum": ["days", "months", "years"]}}}}
      ]
    },
    "legal_hold": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "approval_reference"],
      "properties": {"state": {"enum": ["disabled", "enabled"]}, "approval_reference": {"type": ["string", "null"], "pattern": "^approval://[A-Za-z0-9][A-Za-z0-9._~/-]{1,255}$"}},
      "allOf": [{"if": {"properties": {"state": {"const": "enabled"}}, "required": ["state"]}, "then": {"properties": {"approval_reference": {"type": "string"}}}}]
    },
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "urn:aegis-mesh:schema:forensics:evidence-event:1.0.0"}},
    "chain_head_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
