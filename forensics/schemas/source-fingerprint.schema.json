{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aegis-mesh:schema:forensics:source-fingerprint:1.0.0",
  "title": "Aegis Mesh forensic source fingerprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "fingerprint_id", "fingerprint_version", "supersedes_fingerprint_hash", "fingerprint_hash",
    "incident_id", "first_seen", "last_seen",
    "classification", "confidence", "supporting_evidence", "contradicting_evidence",
    "source_ip", "source_ip_basis", "source_port", "asn", "network_prefix", "network_org",
    "coarse_region", "hosting_vpn_proxy_tor_signals", "reverse_dns", "protocol",
    "tls_version", "cipher_suite", "ja3_ja4", "transport_fingerprint",
    "pseudonymized_user_agent", "request_family", "rates", "status_codes",
    "challenge_result", "cdn_waf_trace_ids", "pseudonymized_account_session_device",
    "raw_evidence_ref", "content_hash", "collected_by", "collected_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "fingerprint_id": {"$ref": "#/$defs/uuid"},
    "fingerprint_version": {"type": "integer", "minimum": 1},
    "supersedes_fingerprint_hash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "fingerprint_hash": {"$ref": "#/$defs/hash"},
    "incident_id": {"$ref": "#/$defs/uuid"},
    "first_seen": {"$ref": "#/$defs/timestamp"},
    "last_seen": {"$ref": "#/$defs/timestamp"},
    "classification": {"enum": ["observed", "suspicious", "likely-malicious", "confirmed-malicious", "false-positive", "closed"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "supporting_evidence": {"type": "array", "items": {"$ref": "urn:aegis-mesh:schema:incident-event:1.0.0#/$defs/evidenceReference"}, "uniqueItems": true},
    "contradicting_evidence": {"type": "array", "items": {"$ref": "urn:aegis-mesh:schema:incident-event:1.0.0#/$defs/evidenceReference"}, "uniqueItems": true},
    "source_ip": {"oneOf": [{"type": "string", "format": "ipv4"}, {"type": "string", "format": "ipv6"}]},
    "source_ip_basis": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "trusted_proxy_ref", "forwarded_chain_hops"],
      "properties": {
        "method": {"enum": ["direct_peer", "trusted_proxy_chain"]},
        "trusted_proxy_ref": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"},
        "forwarded_chain_hops": {"type": "integer", "minimum": 0, "maximum": 32}
      },
      "allOf": [
        {"if": {"properties": {"method": {"const": "direct_peer"}}, "required": ["method"]}, "then": {"properties": {"trusted_proxy_ref": {"type": "null"}, "forwarded_chain_hops": {"const": 0}}}},
        {"if": {"properties": {"method": {"const": "trusted_proxy_chain"}}, "required": ["method"]}, "then": {"properties": {"trusted_proxy_ref": {"type": "string"}, "forwarded_chain_hops": {"type": "integer", "minimum": 1}}}}
      ]
    },
    "source_port": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535},
    "asn": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
    "network_prefix": {"type": ["string", "null"], "maxLength": 64},
    "network_org": {"type": ["string", "null"], "maxLength": 256},
    "coarse_region": {
      "type": "object", "additionalProperties": false,
      "required": ["country_code", "subdivision_code"],
      "properties": {
        "country_code": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$"},
        "subdivision_code": {"type": ["string", "null"], "pattern": "^[A-Z0-9-]{1,16}$"}
      }
    },
    "hosting_vpn_proxy_tor_signals": {
      "type": "object", "additionalProperties": false,
      "required": ["hosting", "vpn", "proxy", "tor"],
      "properties": {
        "hosting": {"$ref": "#/$defs/triState"}, "vpn": {"$ref": "#/$defs/triState"},
        "proxy": {"$ref": "#/$defs/triState"}, "tor": {"$ref": "#/$defs/triState"}
      }
    },
    "reverse_dns": {
      "type": "object", "additionalProperties": false,
      "required": ["hostname", "queried_at"],
      "properties": {"hostname": {"type": ["string", "null"], "maxLength": 253}, "queried_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}}
    },
    "protocol": {"enum": ["tcp", "udp", "quic", "unknown"]},
    "tls_version": {"type": ["string", "null"], "maxLength": 32},
    "cipher_suite": {"type": ["string", "null"], "maxLength": 128},
    "ja3_ja4": {
      "type": "object", "additionalProperties": false,
      "required": ["ja3", "ja4"],
      "properties": {"ja3": {"type": ["string", "null"], "maxLength": 128}, "ja4": {"type": ["string", "null"], "maxLength": 128}}
    },
    "transport_fingerprint": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {"kind": {"type": ["string", "null"], "maxLength": 64}, "value": {"type": ["string", "null"], "maxLength": 256}}
    },
    "pseudonymized_user_agent": {"$ref": "#/$defs/pseudonym"},
    "request_family": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"}, "uniqueItems": true},
    "rates": {
      "type": "object", "additionalProperties": false, "required": ["count", "window_seconds"],
      "properties": {"count": {"type": "integer", "minimum": 0}, "window_seconds": {"type": "integer", "minimum": 1}}
    },
    "status_codes": {
      "type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["status_code", "count"], "properties": {"status_code": {"type": "integer", "minimum": 100, "maximum": 599}, "count": {"type": "integer", "minimum": 0}}}, "uniqueItems": true
    },
    "challenge_result": {"enum": ["passed", "failed", "not_challenged", "unknown"]},
    "cdn_waf_trace_ids": {
      "type": "object", "additionalProperties": false, "required": ["cdn", "waf"],
      "properties": {"cdn": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}, "waf": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}}
    },
    "pseudonymized_account_session_device": {
      "type": "object", "additionalProperties": false, "required": ["account", "session", "device"],
      "properties": {"account": {"$ref": "#/$defs/pseudonym"}, "session": {"$ref": "#/$defs/pseudonym"}, "device": {"$ref": "#/$defs/pseudonym"}}
    },
    "raw_evidence_ref": {"$ref": "urn:aegis-mesh:schema:incident-event:1.0.0#/$defs/evidenceReference"},
    "content_hash": {"$ref": "#/$defs/hash"},
    "collected_by": {
      "type": "object", "additionalProperties": false, "required": ["collector_id", "collector_version", "collection_method"],
      "properties": {"collector_id": {"$ref": "#/$defs/id"}, "collector_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "collection_method": {"enum": ["passive_owned_telemetry", "passive_authorized_telemetry"]}}
    },
    "collected_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"},
    "triState": {"enum": ["observed", "not_observed", "unknown"]},
    "pseudonym": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["pseudonym_ref", "scheme", "key_version"], "properties": {"pseudonym_ref": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"}, "scheme": {"const": "hmac-sha256"}, "key_version": {"$ref": "#/$defs/id"}}}
      ]
    }
  }
}
