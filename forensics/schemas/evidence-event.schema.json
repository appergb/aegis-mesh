{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aegis-mesh:schema:forensics:evidence-event:1.0.0",
  "title": "Aegis Mesh append-only evidence custody event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "custody_event_id", "incident_id", "evidence_id", "actor", "timestamp", "action", "reason", "approval_reference", "input_hash", "output_hash", "storage_ref", "storage_version", "transformation_note", "previous_event_hash", "event_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "custody_event_id": {"type": "string", "format": "uuid"},
    "incident_id": {"type": "string", "format": "uuid"},
    "evidence_id": {"type": "string", "format": "uuid"},
    "actor": {
      "type": "object", "additionalProperties": false, "required": ["actor_id", "actor_type"],
      "properties": {"actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"}, "actor_type": {"enum": ["agent", "human", "system"]}}
    },
    "timestamp": {"$ref": "#/$defs/timestamp"},
    "action": {"enum": ["collection", "transform", "access", "export", "delete"]},
    "reason": {"type": "string", "minLength": 1, "maxLength": 1024},
    "approval_reference": {"type": ["string", "null"], "pattern": "^approval://[A-Za-z0-9][A-Za-z0-9._~/-]{1,255}$"},
    "input_hash": {"$ref": "#/$defs/hash"},
    "output_hash": {"$ref": "#/$defs/hash"},
    "storage_ref": {"type": "string", "pattern": "^evidence://[A-Za-z0-9][A-Za-z0-9._~-]*(?:/[A-Za-z0-9][A-Za-z0-9._~-]*)+$"},
    "storage_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"},
    "transformation_note": {"type": "string", "minLength": 1, "maxLength": 1024},
    "previous_event_hash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "event_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"enum": ["export", "delete"]}}, "required": ["action"]},
      "then": {"properties": {"approval_reference": {"type": "string"}}}
    }
  ],
  "$defs": {
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
